# URL API Laravel (server-side). Boleh URL internal jika satu server.
CMS_API_URL=http://localhost:8000/api/v1
# URL API publik (dipakai browser untuk submit formulir pendaftaran)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Origin media Laravel (gambar dari /storage)
CMS_MEDIA_URL=http://localhost:8000
# URL publik website ini (untuk SEO, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cache fallback (detik). Perubahan di CMS langsung terlihat via /api/revalidate.
CMS_REVALIDATE_SECONDS=300
# Harus sama dengan FRONTEND_REVALIDATE_SECRET di .env Laravel
REVALIDATE_SECRET=ganti-dengan-string-acak
