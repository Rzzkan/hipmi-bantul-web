# Production — dimuat otomatis oleh `next build` / `next start`.
# Tidak berisi rahasia; REVALIDATE_SECRET di-set di environment hosting
# (Vercel: Settings → Environment Variables, VPS: .env.production.local).
CMS_API_URL=https://api.hipmibantul.com/api/v1
NEXT_PUBLIC_API_URL=https://api.hipmibantul.com/api/v1
# URL publik bucket Cloudflare R2 (custom domain). *.r2.dev selalu diizinkan.
CMS_MEDIA_CDN_URL=https://media.hipmibantul.com
CMS_MEDIA_URL=https://api.hipmibantul.com
NEXT_PUBLIC_SITE_URL=https://web.hipmibantul.com
CMS_REVALIDATE_SECONDS=300
